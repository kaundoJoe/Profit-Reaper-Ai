const http=require('http'),fs=require('fs'),path=require('path'),crypto=require('crypto');
const WebSocket=require('ws');
const E=process.env,PORT=E.PORT||3000,DBF=E.DB_FILE||path.join(__dirname,'data.json');
const ADMIN_PASS=E.ADMIN_PASS||E.OWNER_PASSWORD||'ChangeMe123!';
function load(){try{return JSON.parse(fs.readFileSync(DBF,'utf8'))}catch(e){return{users:[],licenses:[],signals:[],settings:{winRate:72,interval:5,mode:'auto'}}}}
let DB=load(); if(!DB.users)DB.users=[]; if(!DB.licenses)DB.licenses=[]; if(!DB.signals)DB.signals=[]; if(!DB.settings)DB.settings={winRate:72,interval:5,mode:'auto'};
function save(){try{fs.writeFileSync(DBF,JSON.stringify(DB,null,2))}catch(e){console.log('SAVE FAIL',e.message)}}
function json(res,o,c){res.writeHead(c||200,{'Content-Type':'application/json'});res.end(JSON.stringify(o))}
function page(res,f){try{const h=fs.readFileSync(path.join(__dirname,f));res.writeHead(200,{'Content-Type':'text/html; charset=utf-8','Cache-Control':'no-store'});res.end(h)}catch(e){res.writeHead(404);res.end('Not found: '+f)}}
function body(req,cb){let b='';req.on('data',c=>b+=c);req.on('end',()=>{try{cb(JSON.parse(b||'{}'))}catch(e){cb({})}})}
function genKey(){return 'PR-'+crypto.randomBytes(4).toString('hex').toUpperCase()+'-'+crypto.randomBytes(4).toString('hex').toUpperCase()}
function adminToken(){return crypto.createHash('sha256').update(ADMIN_PASS+'::profit-reaper').digest('hex')}
function isAdmin(req){const c=req.headers.cookie||'';return c.includes('pr_admin='+adminToken())}
// --- REAL DERIV ---
const DERIV_MAP={'Volatility 10 Index':'R_10','Volatility 25 Index':'R_25','Volatility 50 Index':'R_50','Volatility 75 Index':'R_75','Volatility 100 Index':'R_100','Volatility 150 Index':'R_150','Volatility 250 Index':'R_250','Boom 1000 Index':'BOOM1000','Boom 500 Index':'BOOM500','Boom 300 Index':'BOOM300','Crash 1000 Index':'CRASH1000','Crash 500 Index':'CRASH500','Crash 300 Index':'CRASH300','Step Index':'STEPINDX','Jump 10 Index':'JD10','Jump 25 Index':'JD25','Jump 50 Index':'JD50','Jump 75 Index':'JD75','Jump 100 Index':'JD100','EUR/USD':'frxEURUSD','GBP/USD':'frxGBPUSD','USD/JPY':'frxUSDJPY','AUD/USD':'frxAUDUSD','USD/CAD':'frxUSDCAD','BTC/USD':'cryBTCUSD','ETH/USD':'cryETHUSD','Gold (XAU/USD)':'frxXAUUSD'};
const ALL_SYMBOLS=Object.keys(DERIV_MAP);
function calcEMA(closes,p){const k=2/(p+1);let e=closes[0];for(let i=1;i<closes.length;i++)e=closes[i]*k+e*(1-k);return e}
function calcRSI(closes,period=14){let g=0,l=0;for(let i=1;i<=period;i++){let d=closes[i]-closes[i-1];if(d>0)g+=d;else l+=-d}let ag=g/period,al=l/period;for(let i=period+1;i<closes.length;i++){let d=closes[i]-closes[i-1];let gg=d>0?d:0,ll=d<0?-d:0;ag=(ag*(period-1)+gg)/period;al=(al*(period-1)+ll)/period}if(al===0)return 100;let rs=ag/al;return 100-(100/(1+rs))}
let candleCache={};
function fetchDerivCandles(name){return new Promise((resolve)=>{const sym=DERIV_MAP[name];if(!sym)return resolve(null);if(candleCache[name]&&Date.now()-candleCache[name].time<60000)return resolve(candleCache[name].closes);try{const ws=new WebSocket('wss://ws.derivws.com/websockets/v3?app_id=1089');const to=setTimeout(()=>{try{ws.close()}catch(e){}resolve(null)},8000);ws.on('open',()=>{ws.send(JSON.stringify({ticks_history:sym,adjust_start_time:1,count:100,end:'latest',style:'candles',granularity:60}))});ws.on('message',(d)=>{try{const j=JSON.parse(d.toString());if(j.candles){clearTimeout(to);const closes=j.candles.map(c=>c.close);candleCache[name]={closes,time:Date.now()};try{ws.close()}catch(e){}resolve(closes)}}catch(e){}});ws.on('error',()=>{clearTimeout(to);resolve(null)})}catch(e){resolve(null)}})}
async function genRealSignal(symbolName){const symbol=symbolName||ALL_SYMBOLS[Math.floor(Math.random()*ALL_SYMBOLS.length)];const closes=await fetchDerivCandles(symbol);if(!closes||closes.length<60)return{id:Date.now(),pair:symbol,direction:'WAIT',time:new Date().toLocaleTimeString(),date:new Date().toLocaleDateString(),confidence:0,reason:'No live data from Deriv - retrying',score:0,real:false};const rsi=calcRSI(closes,14);const ema20=calcEMA(closes,20);const ema50=calcEMA(closes,50);const last=closes[closes.length-1];const prev=closes[closes.length-2];let score=0,reasons=[];if(rsi<30){score+=3;reasons.push('RSI oversold '+rsi.toFixed(1))}else if(rsi>70){score-=3;reasons.push('RSI overbought '+rsi.toFixed(1))}else if(rsi>50){score+=1;reasons.push('RSI bullish '+rsi.toFixed(1))}else{score-=1;reasons.push('RSI bearish '+rsi.toFixed(1))}if(ema20>ema50){score+=2;reasons.push('EMA20 > EMA50 uptrend')}else{score-=2;reasons.push('EMA20 < EMA50 downtrend')}if(last>prev){score+=1;reasons.push('Last candle green')}else{score-=1;reasons.push('Last candle red')}if(last>ema20){score+=1;reasons.push('Price above EMA20')}else{score-=1;reasons.push('Price below EMA20')}let direction='WAIT',confidence=50;if(score>=3){direction='CALL';confidence=Math.min(92,60+score*6)}else if(score<=-3){direction='PUT';confidence=Math.min(92,60+Math.abs(score)*6)}else{direction='WAIT';confidence=45}return{id:Date.now(),pair:symbol,direction,time:new Date().toLocaleTimeString(),date:new Date().toLocaleDateString(),confidence:Math.round(confidence),rsi:Math.round(rsi*10)/10,ema20:Math.round(ema20*100)/100,ema50:Math.round(ema50*100)/100,price:last,score,reason:reasons.join(' | '),real:true}}
const server=http.createServer((req,res)=>{
const u=new URL(req.url,'http://x');const p=u.pathname;
if(p==='/'||p==='/index.html')return page(res,'index.html');
if(p==='/app'||p==='/app.html')return page(res,'app.html');
if(p==='/admin-login.html')return page(res,'admin-login.html');
if(p==='/admin'||p==='/admin.html'){if(!isAdmin(req)){res.writeHead(302,{Location:'/admin-login.html'});return res.end('Login required')}return page(res,'admin.html')}
if(p==='/api/status')return json(res,{ok:true,online:true,winRate:DB.settings.winRate,interval:DB.settings.interval,mode:DB.settings.mode,total:DB.signals.length});
if(p==='/api/signals')return json(res,{signals:DB.signals.slice(-20).reverse()});
if(p==='/api/signal'){const sym=u.searchParams.get('symbol');genRealSignal(sym).then(s=>{if(s.direction!=='WAIT'){DB.signals.push(s);if(DB.signals.length>100)DB.signals=DB.signals.slice(-100);save()}return json(res,{signal:s})});return}
if(p==='/api/analyze-all'){(async()=>{let results=[];for(let sym of ALL_SYMBOLS){let s=await genRealSignal(sym);if(s.direction!=='WAIT'&&s.confidence>=65)results.push(s)}return json(res,{ok:true,analyzed:ALL_SYMBOLS.length,strong:results})})();return}
if(p==='/api/register'&&req.method==='POST'){return body(req,j=>{if(!j.email||!j.password||!j.name)return json(res,{ok:false,error:'Missing name, email or password'},400);if(DB.users.find(x=>x.email===j.email.toLowerCase()))return json(res,{ok:false,error:'Email already exists - try Login'},400);const key=genKey();const user={id:Date.now(),name:j.name,email:j.email.toLowerCase(),password:j.password,created:new Date().toISOString()};const lic={key,email:user.email,plan:j.plan||'activation',status:'pending',created:new Date().toISOString()};DB.users.push(user);DB.licenses.push(lic);save();return json(res,{ok:true,user:{name:user.name,email:user.email},license:lic})})}
if(p==='/api/login'&&req.method==='POST'){return body(req,j=>{const user=DB.users.find(x=>x.email===(j.email||'').toLowerCase()&&x.password===j.password);if(!user)return json(res,{ok:false,error:'Wrong email or password'},401);const lic=DB.licenses.filter(x=>x.email===user.email);return json(res,{ok:true,user:{name:user.name,email:user.email},licenses:lic})})}
if(p==='/api/admin/login'&&req.method==='POST'){return body(req,j=>{if(j.password===ADMIN_PASS){res.setHeader('Set-Cookie','pr_admin='+adminToken()+'; Path=/; HttpOnly; SameSite=Lax');return json(res,{ok:true})}return json(res,{ok:false,error:'Wrong admin password'},401)})}
if(p==='/api/admin/logout'&&req.method==='POST'){res.setHeader('Set-Cookie','pr_admin=; Path=/; Max-Age=0');return json(res,{ok:true})}
if(p==='/api/admin/data'){if(!isAdmin(req))return json(res,{ok:false,error:'Admin login required'},401);return json(res,{ok:true,users:DB.users,licenses:DB.licenses,settings:DB.settings,signals:DB.signals.slice(-20)})}
if(p==='/api/admin/settings'&&req.method==='POST'){if(!isAdmin(req))return json(res,{ok:false,error:'Admin login required'},401);return body(req,j=>{DB.settings={...DB.settings,...j};save();return json(res,{ok:true})})}
if(p==='/api/admin/activate'&&req.method==='POST'){if(!isAdmin(req))return json(res,{ok:false,error:'Admin login required'},401);return body(req,j=>{const l=DB.licenses.find(x=>x.key===j.key);if(!l)return json(res,{ok:false,error:'Key not found'},404);l.status='active';l.activated=new Date().toISOString();save();return json(res,{ok:true,license:l})})}
res.writeHead(404);res.end('Not found');
});
server.listen(PORT,()=>console.log('Profit Reaper Running on '+PORT));
