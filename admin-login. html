<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Login</title><style>body{font-family:Arial;background:#0a0a0a;color:#fff;text-align:center;padding:40px}input{padding:12px;width:85%;border-radius:10px;border:none;margin:10px}button{background:#00e676;padding:13px;border:none;border-radius:10px;font-weight:bold;width:90%}</style></head><body>
<h1>🔒 ADMIN LOGIN</h1><input id="pass" type="password" placeholder="Admin Password"><button onclick="login()">Login</button><p id="msg"></p>
<script>async function login(){let r=await fetch('/api/admin/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:pass.value})});let j=await r.json();if(j.ok)location.href='/admin';else msg.innerText='❌ Wrong password'}</script></body></html>
